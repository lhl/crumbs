# --- Secrets and local environment (never commit) ---
.env
.env.*
!.env.example
!.env.sample
!.env.template
*.pem
*.key
*.p12
*.pfx
*.keystore
credentials*
secrets*
service-account*.json
.netrc
id_rsa*
id_ed25519*

# --- Personal data: photos, location history, check-in exports ---
# Crumbs processes exactly this kind of data. Real personal data never
# enters git -- not in commits, fixtures, screenshots, or demo assets.
# Use synthetic or explicitly consented, reviewed fixtures under
# tests/fixtures/ instead (see AGENTS.md).
/data/
/private/
/photos/
/exports/
/location-history/
/takeout/
*.gpx
*.kml
*.kmz

# --- Demo video working files (raw voiceover, footage, transcripts) ---
/demo/video/

# --- Model weights and large artifacts ---
*.safetensors
*.gguf
*.onnx
*.pt
*.pth
*.ckpt
/models/
/weights/

